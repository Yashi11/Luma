{
  "name": "visual-copilot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first visual explanation copilot for macOS",
  "author": "Yashi11",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build -- --pretty false",
    "package:dir": "npm run build && electron-builder --mac dir --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "dev.yashi11.visual-copilot",
    "productName": "Visual Copilot",
    "asar": true,
    "files": ["dist/**/*", "package.json"],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "target": ["dmg", "zip"]
    }
  }
}
